// dev-kit flow diagram (v1.5.0). Render:
//   cd docs && dot -Tsvg dev-kit-flow.dot -o dev-kit-flow.svg && dot -Tpng -Gdpi=110 dev-kit-flow.dot -o dev-kit-flow.png
digraph G {
  graph [fontname="Helvetica,sans-Serif", labelloc=t, fontsize=13, nodesep=0.35, ranksep=0.42, pad=0.3,
         label=<<b>dev-kit v1.5 — flow, dependencies, parallelism and controls</b>>];
  node  [fontname="Helvetica,sans-Serif", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef2f7", color="#5b6b7f"];
  edge  [fontname="Helvetica,sans-Serif", fontsize=9, color="#5b6b7f", fontcolor="#5b6b7f"];

  // entry points
  start [label="/dev-kit:start\n(routes: new project or resume;\nstarts a session in the log)", fillcolor="#fff3c4", color="#b8860b"];
  interview [label="interview → brief.md\nalso asks: autonomy (supervised | unattended | custom),\nmodel/effort ladder, local preview, production deploy"];
  auto [label="/dev-kit:autopilot\n(drives everything below on its own)\npauses follow pause_policy: supervised asks,\nunattended parks what needs you and goes on", fillcolor="#fff3c4", color="#b8860b"];

  start -> interview [label="new project"];

  subgraph cluster_plan {
    label="1 · Specification (sequential, one agent at a time)"; fontsize=11; style="rounded,dashed"; color="#999999";
    prd   [label="prd\n→ prd.md (AC-n)"];
    rprd  [label="review prd\nrequirements-reviewer (opus)", fillcolor="#e3f4e1", color="#3c8d40"];
    arch  [label="architecture\n→ architecture.md + ADRs\n(+ preview / deploy commands)"];
    architect [label="architect\n(consultant, read-only, opus)", fillcolor="#e3f4e1", color="#3c8d40"];
    ux    [label="ux\n→ ux-flows.md\n(only if there is a UI)"];
    ui    [label="ui\n→ ui-spec.md\n(only if there is a UI)"];
    rdes  [label="review design\ndesign-reviewer", fillcolor="#e3f4e1", color="#3c8d40"];
    plan  [label="plan\n→ plan.md (milestones M1..Mn,\ntasks T-xxx with deps and files)"];
    rplan [label="review plan\nrequirements-reviewer", fillcolor="#e3f4e1", color="#3c8d40"];
  }

  auto -> prd [label="orchestrates", style=dashed];
  interview -> prd;
  prd -> rprd;
  rprd -> prd [label="fails: revise\n(delta: round 2+ checks\nonly what was fixed)", color="#b33a3a", fontcolor="#b33a3a", style=dashed];
  rprd -> arch [label="pass"];
  arch -> architect [style=dashed, arrowhead=none];
  arch -> ux [label="has UI"];
  arch -> plan [label="no UI", style=dashed];
  ux -> ui -> rdes;
  rdes -> plan [label="pass"];
  plan -> rplan;

  subgraph cluster_build {
    label="2 · For each milestone Mn (in order; Mn+1 starts only after the Mn gate passes)"; fontsize=11; style=rounded; color="#2f6fb0";
    pull [label="milestone start: pull-issues\nqueued issues fill the buffer (20% of planned tasks)\nstandard before intangible · the rest waits\n(milestones are never created or renumbered)", fillcolor="#fff7e6", color="#c28a1a"];
    impl [label="implement\nnext ready task: hotfix lane → cool-down lane → fixes → plan\ntests first → full suite → 1 commit per task", fillcolor="#dbe9fb", color="#2f6fb0"];
    par  [shape=Mrecord, fillcolor="#ffe0cc", color="#c25b1a",
          label="{--parallel N: INDEPENDENT SUBTASKS|{implementer\nT-004\nworktree · slot 1|implementer\nT-005\nworktree · slot 2|implementer\nT-006\nworktree · slot 3}|deps done, files do NOT overlap (max N);\nshared files (migrations, lockfiles,\nregistries) run serially\nown port, database, PIDs per slot}"];
    verify [label="orchestrator (you / autopilot) integrates\none at a time: merge worktree, suite,\ndiff review, commit (hooks run here only)\n+ marks done · cleanup leftover PIDs\n(implementers do NOT commit)"];
    qa   [label="qa Mn\npicks auditors based on what changed", fillcolor="#dbe9fb", color="#2f6fb0"];
    aud  [shape=Mrecord, fillcolor="#ffe0cc", color="#c25b1a",
          label="{AUDITORS IN PARALLEL (read-only, one slot each)|always:\ncode-reviewer · security-auditor (opus)\ntest-auditor · spec-tracer (opus) · ops-reviewer|if applicable:\ndata-reviewer · deps-auditor (haiku)\nperformance-auditor · a11y · visual · copy (haiku)|heavy auditors (browsers, e2e): max nproc/3 at a time\nround 2+: only failed dimensions, next model/effort step}"];
    score [label="dev_score.py → 0-100 per dimension vs. cut-off\nlow findings capped · same finding from two audits counts once\nround 2+ delta: previous findings closed or open;\nnew lows recorded, not scored"];
    gate [label="gate\npassed?", shape=diamond, fillcolor="#fff3c4", color="#b8860b"];
    fix  [label="creates fix tasks\nback to implement\nrounds exhausted → pause_policy:\nask · apply recommendation · park", fillcolor="#fde2e2", color="#b33a3a"];
    cool [label="cool-down (optional, autonomy.cooldown)\nsmall issues (S, low/medium, max 5)\ngo into Mn+1 first, audited by its qa", fillcolor="#fff7e6", color="#c28a1a"];
    ship [label="after an approved gate (optional):\nlocal preview on 127.0.0.1 (keep running | smoke)\ndeploy to production when per_milestone\n(consent: pause_policy.production_deploy)", fillcolor="#d6f0d6", color="#3c8d40"];
  }

  rplan -> pull [label="pass"];
  pull -> impl;
  impl -> par [label="≥3 independent\ntasks", style=dashed];
  impl -> verify [label="serial\n(default)", style=dashed];
  par -> verify;
  verify -> impl [label="next task", style=dashed];
  verify -> qa [label="milestone complete"];
  qa -> aud -> score -> gate;
  gate -> cool [label="yes", color="#3c8d40", fontcolor="#3c8d40"];
  cool -> ship [color="#3c8d40"];
  ship -> pull [label="next Mn+1", color="#3c8d40", fontcolor="#3c8d40"];
  gate -> fix [label="no"];
  fix -> impl [color="#b33a3a"];

  subgraph cluster_end {
    label="3 · Wrap-up (after the last milestone)"; fontsize=11; style="rounded,dashed"; color="#999999";
    usab [label="usability\na11y + usability + visual + copy\n(score = review ux, delta rounds)"];
    docs [label="docs all\n→ README, docs/, CHANGELOG"];
    rdoc [label="review docs\ndocs-reviewer (haiku)", fillcolor="#e3f4e1", color="#3c8d40"];
    rel  [label="release\n(--dry-run first)", fillcolor="#dbe9fb", color="#2f6fb0"];
    relaud [shape=Mrecord, fillcolor="#ffe0cc", color="#c25b1a",
            label="{RELEASE AUDIT IN PARALLEL|spec-tracer · security · ops\ndeps · data (if database)\nperformance · docs-reviewer|fails → fix tasks → implement → release again}"];
    done [label="version + tag + release notes\ndeploy when production.when = on_release\n(push/publish only if authorized)", fillcolor="#d6f0d6", color="#3c8d40"];
  }

  ship -> usab [label="last Mn", color="#3c8d40", fontcolor="#3c8d40"];
  usab -> docs -> rdoc -> rel -> relaud -> done;

  subgraph cluster_obs {
    label="Anytime · issues and follow-up (issue writes; the others are read-only; all recorded in the log)"; fontsize=11; style="rounded,dashed"; color="#7a5aa6";
    status   [label="/dev-kit:status\nphase, gates, preview, production drift,\nleftover processes, cost so far", fillcolor="#efe7f8", color="#7a5aa6"];
    costs    [label="/dev-kit:costs\ntokens (input, output, cache) and\nestimated US$ per stage, agent, model\n(from local transcripts; CSV on request)", fillcolor="#efe7f8", color="#7a5aa6"];
    feedback [label="/dev-kit:feedback\ngrade 0-100 per stage with reasons,\nwhat worked / failed, suggestions;\ntimestamped report + export for the author", fillcolor="#efe7f8", color="#7a5aa6"];
    help     [label="/dev-kit:help [skill | question]\nwhat to do next · how each skill works\nrecipes, concepts, agents (docs/ generated\nfrom the same catalog)", fillcolor="#fff3c4", color="#b8860b"];
    issue    [label="/dev-kit:issue \"what happened\"\nclassifies: expedite (hotfix now, WIP 1, patch release)\ncurrent (this milestone) · standard (next buffer)\nintangible (cool-down) · change (PRD → replan)", fillcolor="#fff3c4", color="#b8860b"];
    backlog  [label="/dev-kit:backlog\neverything pending: hotfix, queue, buffer,\ntasks, parked questions, deferred findings,\ndeploys · recommended next step", fillcolor="#efe7f8", color="#7a5aa6"];
    tips     [label="💡 short tips from tips.json\nshown when a mechanism matters (each twice)", shape=note, fillcolor="#f7f3fb", color="#7a5aa6"];
    tlog     [label=".dev/telemetry.jsonl\nstructured session log, no project data\n(skills, agents, rounds, scores, pauses, costs, feedback)", shape=note, fillcolor="#f7f3fb", color="#7a5aa6"];
  }

  tlog -> status [style=dotted, color="#7a5aa6", arrowhead=none];
  tlog -> costs [style=dotted, color="#7a5aa6"];
  tlog -> feedback [style=dotted, color="#7a5aa6"];
  done -> feedback [style=invis];
  issue -> impl [label="expedite / current", style=dashed, color="#b8860b", fontcolor="#b8860b", constraint=false];
  issue -> pull [label="standard / intangible\n(queue)", style=dashed, color="#b8860b", fontcolor="#b8860b", constraint=false];
  issue -> prd [label="change", style=dashed, color="#b8860b", fontcolor="#b8860b", constraint=false];
  issue -> backlog [style=dotted, color="#7a5aa6", arrowhead=none];
  tips -> backlog [style=invis];
  help -> status [style=dotted, color="#7a5aa6", arrowhead=none];
}
